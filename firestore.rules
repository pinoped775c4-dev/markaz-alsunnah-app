rules_version = '2';

// =====================================================================
// قواعد أمان Firestore — مركز السنة للعلوم الشرعية وتأهيل الدعاة
// =====================================================================
// ملاحظة نشر مهمة: هذا الملف جاهز للنشر عبر Firebase Console:
//   Firestore Database -> Rules -> لصق المحتوى -> Publish
//
// مبدأ الصلاحيات:
// - المدير (admin): صلاحية كاملة على كل البيانات.
// - المعلم (teacher): يقرأ ويكتب بياناته الخاصة فقط (طلابه، دروسه،
//   تسجيلاته). لا يصل لبيانات معلم آخر ولا يحذفها.
// - معلم المتون والأوراد المخصص: يضيف سجلات رسمية (isOfficial=true).
// - أي مستخدم مسجل: يقرأ ملفه الشخصي فقط.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== دوال مساعدة ====================

    // هل المستخدم مسجل الدخول؟
    function isSignedIn() {
      return request.auth != null;
    }

    // وثيقة المستخدم الحالي
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // هل المستخدم مدير؟
    function isAdmin() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().data.role == 'admin';
    }

    // هل المستخدم معلم؟
    function isTeacher() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().data.role == 'teacher';
    }

    // هل المستخدم مدير أو معلم؟ (أي مستخدم مسموح له بالعمل)
    function isAuthorized() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && (userDoc().data.role == 'admin' || userDoc().data.role == 'teacher');
    }

    // معلم المتون والأوراد المخصص في app_settings/mutun_wird
    function mutunWirdDoc() {
      return get(/databases/$(database)/documents/app_settings/mutun_wird);
    }

    function designatedWirdTeacherUid() {
      return mutunWirdDoc().data.teacherUid;
    }

    // هل المتصل هو معلم المتون والأوراد المخصص؟
    function isDesignatedWirdTeacher() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/app_settings/mutun_wird)
          && designatedWirdTeacherUid() == request.auth.uid;
    }

    // ==================== app_settings ====================
    // إعدادات التطبيق (تعيين معلم المتون والأوراد):
    // - القراءة: للمدير ومعلم المتون والأوراد فقط
    // - الكتابة: للمدير فقط
    match /app_settings/{docId} {
      allow read: if isSignedIn() && (isAdmin() || isDesignatedWirdTeacher());
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==================== users ====================
    // ملف المستخدم:
    // - قراءة الملف الذاتي: مسموح
    // - قراءة كل الملفات: المدير فقط
    // - إنشاء/تعديل الملف الذاتي: مسموح (للتسجيل الأولي)
    // - تعديل أي ملف: المدير فقط
    // - حذف: المدير فقط
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // المدير يُنشئ ملفات المستخدمين الآخرين (المعلمين)
      allow create: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == uid || isAdmin())
          // منع المستخدم العادي من تغيير دوره (خصوصاً ترقية نفسه إلى مدير)
          && (isAdmin() || request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // ==================== students ====================
    // الطلاب:
    // - القراءة: المدير + المعلم صاحب الطلاب فقط
    // - الكتابة: المدير + المعلم صاحب الطلاب فقط
    // - الحذف: المدير + المعلم صاحب الطلاب فقط
    match /students/{doc} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
      allow create: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && request.resource.data.teacherId == request.auth.uid)
      );
      allow update: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
      allow delete: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
    }

    // ==================== lessons ====================
    // الدروس:
    // - القراءة: المدير + المعلم صاحب الدرس
    // - الكتابة: المدير + المعلم صاحب الدرس
    // - الحذف: المدير + المعلم صاحب الدرس
    match /lessons/{doc} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
      allow create: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && request.resource.data.teacherId == request.auth.uid)
      );
      allow update: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
      allow delete: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
    }

    // ==================== lesson_recordings ====================
    // تسجيلات الدروس اليومية:
    // - القراءة: المدير + المعلم صاحب التسجيل
    // - الكتابة: المدير + المعلم صاحب التسجيل
    // - الحذف: المدير + المعلم صاحب التسجيل
    match /lesson_recordings/{doc} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
      allow create: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && request.resource.data.teacherId == request.auth.uid)
      );
      allow update: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
      allow delete: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
    }

    // ==================== attendance ====================
    // سجلات الحضور:
    // - مرتبطة بـ lessonId (وليس teacherId مباشرة)
    // - نسمح بقراءتها/كتابتها للمدير أو المعلم صاحب الدرس المرتبط
    match /attendance/{doc} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && request.resource.data.teacherId == request.auth.uid)
      );
      allow update: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
      allow delete: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
    }

    // ==================== mutun ====================
    // المتون (مقررات الحفظ):
    // - القراءة: كل مستخدم مسجل (المعلمون يحتاجون معرفة المقررات)
    // - إنشاء رسمي (isOfficial=true): معلم المتون والأوراد المخصص فقط
    // - إنشاء غير رسمي: المعلم صاحب المتن فقط
    // - حذف رسمي: المعلم المسؤول فقط
    // - حذف غير رسمي: المعلم المسؤول أو صاحب المتن
    match /mutun/{doc} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
          && (
              request.resource.data.isOfficial != true
              || isDesignatedWirdTeacher()
          )
          && (
              isAdmin()
              || request.resource.data.teacherId == request.auth.uid
          );
      allow update: if isSignedIn()
          && (
              request.resource.data.isOfficial != true
              || isDesignatedWirdTeacher()
          )
          && (
              isAdmin()
              || resource.data.teacherId == request.auth.uid
          );
      allow delete: if isSignedIn() && (
          isAdmin()
          || (isDesignatedWirdTeacher() && resource.data.isOfficial == true)
          || resource.data.teacherId == request.auth.uid
      );
    }

    // ==================== mutun_recordings ====================
    // تسجيلات التسميع/الحفظ:
    // - القراءة: المدير + المعلم صاحب التسجيل + معلم المتون والأوراد
    // - إنشاء رسمي: المعلم المسؤول المخصص فقط
    // - إنشاء غير رسمي: المعلم صاحب التسجيل
    // - حذف رسمي: المعلم المسؤول فقط
    // - حذف غير رسمي: المعلم المسؤول أو صاحب التسجيل
    match /mutun_recordings/{doc} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
          || (isTeacher() && resource.data.studentId != null
              // المعلم يقدر يقرأ تسجيلات طلابه
              && exists(/databases/$(database)/documents/students/$(resource.data.studentId)))
          || isDesignatedWirdTeacher()
      );
      allow create: if isSignedIn()
          && (
              request.resource.data.isOfficial != true
              || isDesignatedWirdTeacher()
          )
          && (
              isAdmin()
              || request.resource.data.teacherId == request.auth.uid
          );
      allow update: if isSignedIn()
          && (
              request.resource.data.isOfficial != true
              || isDesignatedWirdTeacher()
          )
          && (
              isAdmin()
              || resource.data.teacherId == request.auth.uid
          );
      allow delete: if isSignedIn() && (
          isAdmin()
          || (isDesignatedWirdTeacher() && resource.data.isOfficial == true)
          || resource.data.teacherId == request.auth.uid
      );
    }

    // ==================== quran_recordings ====================
    // تسجيلات الأوراد القرآنية:
    // - نفس منطق mutun_recordings
    // - الورد الرسمي: المعلم المسؤول المخصص فقط
    match /quran_recordings/{doc} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
          || (isTeacher() && resource.data.studentId != null
              && exists(/databases/$(database)/documents/students/$(resource.data.studentId)))
          || isDesignatedWirdTeacher()
      );
      allow create: if isSignedIn()
          && (
              request.resource.data.isOfficial != true
              || isDesignatedWirdTeacher()
          )
          && (
              isAdmin()
              || request.resource.data.teacherId == request.auth.uid
          );
      allow update: if isSignedIn()
          && (
              request.resource.data.isOfficial != true
              || isDesignatedWirdTeacher()
          )
          && (
              isAdmin()
              || resource.data.teacherId == request.auth.uid
          );
      allow delete: if isSignedIn() && (
          isAdmin()
          || (isDesignatedWirdTeacher() && resource.data.isOfficial == true)
          || resource.data.teacherId == request.auth.uid
      );
    }
  }
}
