rules_version = '2';

// =====================================================================
// قواعد أمان Firestore — مركز السنة للعلوم الشرعية وتأهيل الدعاة
// =====================================================================
// الصلاحيات الأساسية:
// - المدير (admin): صلاحية كاملة.
// - المعلم (teacher): يقرأ ويكتب سجلاته الخاصة فقط.
// - الطلاب: بيانات مشتركة للقراءة بين المعلمين، لكن الإدارة وحدها
//   تستطيع إنشاء/تعديل/حذف الطلاب.
// - مشرف المتون والأوراد: صلاحية مقصودة لإدارة حسابات المعلمين
//   وإضافة/تعديل الدروس نيابةً عنهم.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().data.role == 'admin';
    }

    function isTeacher() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().data.role == 'teacher';
    }

    function isDesignatedWirdTeacher() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/app_settings/mutun_wird)
          && get(/databases/$(database)/documents/app_settings/mutun_wird).data.teacherUid
              == request.auth.uid;
    }

    // ==================== app_settings ====================
    match /app_settings/{docId} {
      allow read: if isSignedIn() && (isAdmin() || isDesignatedWirdTeacher());
      allow create, update, delete: if isAdmin();
    }

    // ==================== users ====================
    // المدير يدير الحسابات، ومشرف المتون يقرأ حسابات المعلمين لإدارتها.
    // المستخدم العادي لا يستطيع إنشاء نفسه كمدير ولا تغيير دوره.
    match /users/{uid} {
      allow read: if isSignedIn()
          && (request.auth.uid == uid || isAdmin() || isDesignatedWirdTeacher());

      allow create: if isAdmin()
          || (request.auth.uid == uid && request.resource.data.role == 'teacher');

      allow update: if isSignedIn()
          && (request.auth.uid == uid || isAdmin())
          && (isAdmin() || request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    // ==================== students ====================
    // الطلاب مشتركون بين المعلمين للقراءة والعمل اليومي.
    // الإدارة وحدها تستطيع إنشاء الطالب أو تعديله أو حذفه.
    match /students/{doc} {
      allow read: if isSignedIn() && (isAdmin() || isTeacher());
      allow create, update, delete: if isAdmin();
    }

    // ==================== lessons ====================
    // مشرف المتون يستطيع إدارة دروس أي معلم نيابةً عنه.
    // المعلم العادي لا يستطيع نقل ملكية الدرس إلى معلم آخر.
    match /lessons/{doc} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
          || isDesignatedWirdTeacher()
      );

      allow create: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && request.resource.data.teacherId == request.auth.uid)
          || isDesignatedWirdTeacher()
      );

      allow update: if isSignedIn() && (
          isAdmin()
          || isDesignatedWirdTeacher()
          || (
              isTeacher()
              && resource.data.teacherId == request.auth.uid
              && request.resource.data.teacherId == request.auth.uid
          )
      );

      allow delete: if isSignedIn() && (
          isAdmin()
          || isDesignatedWirdTeacher()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
    }

    // ==================== lesson_recordings ====================
    match /lesson_recordings/{doc} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
          || isDesignatedWirdTeacher()
      );

      allow create: if isSignedIn() && (
          isAdmin()
          || (isTeacher() && request.resource.data.teacherId == request.auth.uid)
          || isDesignatedWirdTeacher()
      );

      allow update: if isSignedIn() && (
          isAdmin()
          || isDesignatedWirdTeacher()
          || (
              isTeacher()
              && resource.data.teacherId == request.auth.uid
              && request.resource.data.teacherId == request.auth.uid
          )
      );

      allow delete: if isSignedIn() && (
          isAdmin()
          || isDesignatedWirdTeacher()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
    }

    // ==================== attendance ====================
    // لا يكفي تسجيل الدخول لقراءة الحضور؛ الحضور خاص بصاحب السجل
    // أو الإدارة أو مشرف المتون.
    match /attendance/{doc} {
      allow read: if isSignedIn() && (
          isAdmin()
          || isDesignatedWirdTeacher()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );

      allow create: if isSignedIn() && (
          isAdmin()
          || isDesignatedWirdTeacher()
          || (isTeacher() && request.resource.data.teacherId == request.auth.uid)
      );

      allow update, delete: if isSignedIn() && (
          isAdmin()
          || isDesignatedWirdTeacher()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
    }

    // ==================== mutun ====================
    match /mutun/{doc} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
          isAdmin()
          || isDesignatedWirdTeacher()
          || (
              isTeacher()
              && request.resource.data.teacherId == request.auth.uid
              && request.resource.data.isOfficial != true
          )
      );

      allow update: if isSignedIn() && (
          isAdmin()
          || isDesignatedWirdTeacher()
          || (
              isTeacher()
              && resource.data.teacherId == request.auth.uid
              && request.resource.data.teacherId == request.auth.uid
              && request.resource.data.isOfficial != true
          )
      );

      allow delete: if isSignedIn() && (
          isAdmin()
          || isDesignatedWirdTeacher()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
    }

    // ==================== mutun_recordings ====================
    // لا يجوز لمعلم قراءة تسجيلات معلم آخر لمجرد أن التسجيل مرتبط بطالب.
    match /mutun_recordings/{doc} {
      allow read: if isSignedIn() && (
          isAdmin()
          || isDesignatedWirdTeacher()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );

      allow create: if isSignedIn() && (
          isAdmin()
          || isDesignatedWirdTeacher()
          || (
              isTeacher()
              && request.resource.data.teacherId == request.auth.uid
              && request.resource.data.isOfficial != true
          )
      );

      allow update: if isSignedIn() && (
          isAdmin()
          || isDesignatedWirdTeacher()
          || (
              isTeacher()
              && resource.data.teacherId == request.auth.uid
              && request.resource.data.teacherId == request.auth.uid
              && request.resource.data.isOfficial != true
          )
      );

      allow delete: if isSignedIn() && (
          isAdmin()
          || isDesignatedWirdTeacher()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
    }

    // ==================== quran_recordings ====================
    match /quran_recordings/{doc} {
      allow read: if isSignedIn() && (
          isAdmin()
          || isDesignatedWirdTeacher()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );

      allow create: if isSignedIn() && (
          isAdmin()
          || isDesignatedWirdTeacher()
          || (
              isTeacher()
              && request.resource.data.teacherId == request.auth.uid
              && request.resource.data.isOfficial != true
          )
      );

      allow update: if isSignedIn() && (
          isAdmin()
          || isDesignatedWirdTeacher()
          || (
              isTeacher()
              && resource.data.teacherId == request.auth.uid
              && request.resource.data.teacherId == request.auth.uid
              && request.resource.data.isOfficial != true
          )
      );

      allow delete: if isSignedIn() && (
          isAdmin()
          || isDesignatedWirdTeacher()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
    }
  }
}
